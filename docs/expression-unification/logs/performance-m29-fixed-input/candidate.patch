+// One owning transport loop for nullable fixed-width native columns. Keep the
+// per-carrier loop out of the large importer; decoders remain the existing
+// semantic constructors, and are invoked only for non-NULL cells.
+#[inline(never)]
+fn read_fixed_native<T: Clone + Default>(
+    column: &Column,
+    rows: &[usize],
+    mut decode: impl FnMut(&[u8]) -> LocalResult<T>,
+) -> LocalResult<ChunkedVecSized<T>> {
+    let cells = column.raw_cells();
+    let mut output = ChunkedVecSized::with_capacity(rows.len());
+    for &row in rows {
+        output.push(if cells.is_null(row) {
+            None
+        } else {
+            Some(decode(cells.get(row))?)
+        });
+    }
+    Ok(output)
+}
