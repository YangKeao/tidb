@@ -1911,6 +1911,31 @@ impl std::error::Error for NativeDecimalError {
 
 type NativeDecimalResult<T> = std::result::Result<T, NativeDecimalError>;
 
+// Reciprocal constants are derived from the existing powers, not rounded
+// floating point. Entry zero is handled directly by the divider below.
+const NATIVE_WORD_POW10_RECIPROCALS: [u64; 10] = {
+    let mut values = [0; 10];
+    let mut power = 1;
+    while power < TEN_POW.len() {
+        let divisor = TEN_POW[power] as u128;
+        values[power] = (((1_u128 << 64) + divisor - 1) / divisor) as u64;
+        power += 1;
+    }
+    values
+};
+
+// For word <= u32::MAX and divisor <= 1e9, word * divisor < 2^64.
+// The ceil-reciprocal error adds less than word/2^64 < 1/divisor,
+// smaller than the fractional gap to the next quotient. The high product
+// therefore equals exact floor(word/divisor), including boundary multiples.
+#[inline(always)]
+fn native_word_div_pow10(word: u32, power: usize) -> u32 {
+    if power == 0 {
+        return word;
+    }
+    ((u128::from(word) * u128::from(NATIVE_WORD_POW10_RECIPROCALS[power])) >> 64) as u32
+}
