+#[cfg(test)]
+mod native_word_power_tests {
+    use super::*;
+
+    #[test]
+    fn reciprocal_word_division_matches_integer_division() {
+        let mut state = 0xd1b54a32d192ed03_u64;
+        for power in 0..TEN_POW.len() {
+            let divisor = TEN_POW[power];
+            for word in [
+                0,
+                1,
+                u32::MAX - 1,
+                u32::MAX,
+                WORD_BASE - 1,
+                divisor - 1,
+                divisor,
+                divisor + 1,
+            ] {
+                assert_eq!(
+                    native_word_div_pow10(word, power),
+                    word / divisor,
+                    "word={word} power={power}"
+                );
+            }
+            for quotient in [0, 1, 2, 9, 10, 99, u32::MAX / divisor] {
+                let multiple = u64::from(quotient) * u64::from(divisor);
+                for word in [multiple.saturating_sub(1), multiple, multiple + 1] {
+                    if let Ok(word) = u32::try_from(word) {
+                        assert_eq!(
+                            native_word_div_pow10(word, power),
+                            word / divisor,
+                            "boundary word={word} power={power}"
+                        );
+                    }
+                }
+            }
+        }
+        for _ in 0..100_000 {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            let word = (state >> 32) as u32;
+            for power in 0..TEN_POW.len() {
+                assert_eq!(
+                    native_word_div_pow10(word, power),
+                    word / TEN_POW[power],
+                    "random word={word} power={power}"
+                );
+            }
+        }
+    }
+}
